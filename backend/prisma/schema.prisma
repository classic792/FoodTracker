generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StockMovementType {
  RECEIPT
  SALE
  DAMAGE
  DISPOSAL
  CORRECTION

  @@map("stock_movement_type")
}

// IDs are supplied by the caller, matching the SQL schema.
// updatedAt has an insert default only; updates must set it explicitly.
model User {
  id           String   @id @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  batches        Batch[]
  stockMovements StockMovement[]

  @@map("users")
}

model Product {
  id          String   @id @db.Uuid
  productCode String   @unique @map("product_code") @db.VarChar(50)
  name        String   @db.VarChar(150)
  stockUnit   String   @map("stock_unit") @db.VarChar(30)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  batches Batch[]

  @@map("products")
}

model StorageLocation {
  id          String   @id @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  batches Batch[]

  @@map("storage_locations")
}

model Batch {
  id              String   @id @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  createdById     String   @map("created_by_id") @db.Uuid
  manufacturerLot String?  @map("manufacturer_lot") @db.VarChar(100)
  quantity        Int
  expiryDate      DateTime @map("expiry_date") @db.Date
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location       StorageLocation @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stockMovements StockMovement[]

  @@index([expiryDate, id], map: "batches_expiry_date_id_idx")
  @@index([productId, expiryDate, id], map: "batches_product_id_expiry_date_id_idx")
  @@index([locationId, expiryDate, id], map: "batches_location_id_expiry_date_id_idx")
  @@index([createdById], map: "batches_created_by_id_idx")
  @@map("batches")
}

model StockMovement {
  id             String            @id @db.Uuid
  batchId        String            @map("batch_id") @db.Uuid
  performedById  String            @map("performed_by_id") @db.Uuid
  type           StockMovementType
  quantityChange Int               @map("quantity_change")
  reason         String            @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  batch       Batch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  performedBy User  @relation(fields: [performedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([batchId, createdAt, id], map: "stock_movements_batch_id_created_at_id_idx")
  @@index([performedById], map: "stock_movements_performed_by_id_idx")
  @@map("stock_movements")
}
